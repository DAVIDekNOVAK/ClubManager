# Kopiraj v .env:  cp .env.example .env

# Okolje: development | test | production
NODE_ENV=development

# Vrata, na katerih posluša REST API
PORT=3000

# Povezava s PostgreSQL (vrednosti se ujemajo z docker-compose.yml)
DATABASE_URL="postgresql://clubmanager:clubmanager@localhost:5433/clubmanager?schema=public"

# Skrivnost za podpisovanje piškotka seje – v produkciji nastavi dolgo naključno vrednost
SESSION_SECRET="spremeni-me-v-dolgo-nakljucno-vrednost"

# Naslov frontenda (za CORS in povezave v e-pošti)
FRONTEND_URL="http://localhost:5173"

# SMTP strežnik za pošiljanje povabil (lokalno Mailpit iz docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="ClubManager <no-reply@clubmanager.local>"
